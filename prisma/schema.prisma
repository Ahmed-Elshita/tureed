// Tureed — Core Database Schema
// Design goals baked into this schema:
// 1) Categories, attributes, and locations are all DATA, not code — an admin
//    adds/edits them from the dashboard, no deploy needed.
// 2) Every field a seller fills in when posting a listing is a dropdown
//    pulled from AttributeOption — never free text — so data stays clean
//    and filters/search stay reliable.
// 3) Each category defines its OWN set of attributes (a phone has "storage,
//    RAM, condition"; an apartment has "bedrooms, area, furnished"), so the
//    listing form only shows fields relevant to what's being sold.
// 4) Everything is bilingual (ar/en) at the data level, not via duplicate
//    tables, so adding a 3rd language later is a column, not a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// USERS
// ──────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  BOTH
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Gender {
  MALE
  FEMALE
}

enum ReferralSource {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE
  FRIEND
  OTHER
}

model User {
  id            String     @id @default(cuid())
  name          String
  phone         String     @unique
  whatsapp      String?
  email         String?    @unique
  passwordHash  String?
  avatarUrl     String?
  role          UserRole   @default(BUYER)
  status        UserStatus @default(PENDING_VERIFICATION)

  // Trust signals shown on the public seller page — isVerified is set by
  // an admin (ID check, phone confirmed, etc.), the rating fields are
  // denormalized aggregates kept in sync whenever a Review is created so
  // the seller page never has to compute an AVG() on every request.
  isVerified    Boolean    @default(false)
  ratingAvg     Decimal?   @db.Decimal(2, 1)
  ratingCount   Int        @default(0)

  // Seller-facing profile fields (shown on the public seller page)
  storeName     String?
  storeBio      String?
  // Set when the mandatory signup form (name, WhatsApp, location, role,
  // interests) is completed. Null = account exists but can't contact/post yet.
  onboardingCompletedAt DateTime?
  // Lead-generation profile. PRIVATE: never selected on public pages.
  birthDate          DateTime? @db.Date
  gender             Gender?
  referralSource     ReferralSource?   // "how did you hear about us"
  marketingConsent   Boolean   @default(false) // explicit opt-in to receive offers/ads
  marketingConsentAt DateTime?
  coverImageUrl String?    // banner image on the public shop page, like a Facebook cover photo
  locationId    String?
  location      Location?  @relation(fields: [locationId], references: [id])
  // What the shop mainly deals in — optional ("if needed"): a hobbyist
  // reseller might not set one, a dedicated store (e.g. "Men's Shoes")
  // would. Uses the SAME category tree as listings, at any level.
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id])

  products        Product[]
  favorites       Favorite[]
  reports         Report[]   @relation("ReportsFiled")
  reviewsReceived Review[]   @relation("SellerReviews")
  reviewsWritten  Review[]   @relation("AuthorReviews")
  boosts          BoostOrder[]
  adRequests      AdRequest[]
  cartItems       CartItem[]
  purchases       Order[]    @relation("BuyerOrders")
  sales           Order[]    @relation("SellerOrders")
  interests       UserInterestCategory[]
  contactsMade     ContactEvent[] @relation("ContactBuyer")
  contactsReceived ContactEvent[] @relation("ContactSeller")

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([role, status])
}

// A buyer's rating + comment on a seller after a deal. Kept separate from
// Product because trust in classifieds is about the SELLER, not any one
// listing — matches how Dubizzle/OLX-style seller pages work.
model Review {
  id         String   @id @default(cuid())
  sellerId   String
  seller     User     @relation("SellerReviews", fields: [sellerId], references: [id])
  authorId   String
  author     User     @relation("AuthorReviews", fields: [authorId], references: [id])
  rating     Int      // 1–5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sellerId, authorId]) // one review per buyer per seller — re-reviewing UPDATES it, doesn't add another
  @@index([sellerId])
}

// One-time codes for phone login/signup. Never store the raw code — only
// a hash — and every attempt is capped and time-boxed so a leaked table
// can't be used to brute-force a phone number's OTP.
model OtpCode {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  purpose     String    @default("login") // "login" | "signup" | "listing"
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, purpose])
}

// Generic rate-limit ledger — one row per attempted action. Used to cap
// OTP requests per phone/IP and listing-creation bursts per seller, which
// is the cheapest first line of defense against fake-listing spam.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String   // e.g. "otp:+2010...", "listing:+2010...", "ip:41.32.x.x"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ──────────────────────────────────────────────────────────────
// LOCATIONS — self-referencing tree: Governorate > City > District
// Fully admin-editable, unlimited depth, works for Egypt today and
// any other country later (top-level "Country" node).
// ──────────────────────────────────────────────────────────────

model Location {
  id          String     @id @default(cuid())
  nameAr      String
  nameEn      String
  slug        String     @unique
  parentId    String?
  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[] @relation("LocationTree")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  // Optional centroid — lets the map view center on a governorate/city
  // even for listings that didn't set a precise pin themselves.
  lat         Float?
  lng         Float?

  products    Product[]
  sellers     User[]

  @@index([parentId])
}

// ──────────────────────────────────────────────────────────────
// CATEGORIES — self-referencing tree of ANY depth (Fashion > Men > Shoes,
// Real Estate > For Sale > Apartments ...). Each node can carry its own
// attribute set, and a listing's form = the attributes of every ancestor
// PLUS its own (see src/lib/categories.ts getEffectiveAttributes). Listings
// may only be posted in LEAF categories (no active children), so sellers are
// always walked down to the most specific level.
// ──────────────────────────────────────────────────────────────

enum CategoryKind {
  PRODUCT
  REAL_ESTATE
  SERVICE
}

model Category {
  id            String       @id @default(cuid())
  kind          CategoryKind
  nameAr        String
  nameEn        String
  slug          String       @unique
  icon          String?      // icon key, matches the design-system icon set
  parentId      String?
  parent        Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]   @relation("CategoryTree")
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)

  // SEO — editable per category from the admin dashboard
  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String?
  metaDescriptionEn String?

  attributes    CategoryAttribute[]
  products      Product[]
  shopOwners    User[]              // sellers whose shop-page category is this one
  interestedUsers UserInterestCategory[]

  @@index([parentId])
}

enum AttributeInputType {
  SELECT        // single choice dropdown — the default for almost everything
  MULTISELECT   // multiple choice dropdown (e.g. amenities)
  NUMBER        // numeric input (e.g. price, area) — not free text, but not a dropdown either
  BOOLEAN       // yes/no toggle (e.g. "negotiable")
}

// One row = one field on the "add listing" form for a given category,
// e.g. Category "Mobile Phones" -> Attribute "Storage" (SELECT) with
// options 64GB/128GB/256GB/512GB defined in AttributeOption below.
model CategoryAttribute {
  id            String              @id @default(cuid())
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id])
  labelAr       String
  labelEn       String
  inputType     AttributeInputType  @default(SELECT)
  isRequired    Boolean             @default(false)
  isFilterable  Boolean             @default(true)   // show as a search filter
  isActive      Boolean             @default(true)   // hide from forms/filters without deleting (existing listings keep their values)
  sortOrder     Int                 @default(0)

  options       AttributeOption[]
  values        ProductAttributeValue[]

  @@index([categoryId])
}

// The actual dropdown choices for a SELECT/MULTISELECT attribute.
// Admin adds/edits these — sellers only ever pick from this list.
model AttributeOption {
  id            String    @id @default(cuid())
  attributeId   String
  attribute     CategoryAttribute @relation(fields: [attributeId], references: [id])
  labelAr       String
  labelEn       String
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)

  values        ProductAttributeValue[]

  @@index([attributeId])
}

// ──────────────────────────────────────────────────────────────
// PRODUCTS / LISTINGS
// One model covers Products, Real Estate, and Services — the
// `category.kind` tells the UI which layout/labels to use, and
// ProductAttributeValue carries whatever fields that category defined.
// ──────────────────────────────────────────────────────────────

enum ProductCondition {
  NEW
  LIKE_NEW
  USED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW   // in moderation queue
  PUBLISHED
  PAUSED           // seller took it down temporarily — not deleted, not searchable
  REJECTED
  EXPIRED
  SOLD
}

model Product {
  id            String           @id @default(cuid())
  titleAr       String
  titleEn       String?          // auto-filled by AI translation later; optional for now
  slug          String           @unique
  descriptionAr String           @db.Text
  descriptionEn String?          @db.Text

  price         Decimal?         @db.Decimal(12, 2)
  currency      String           @default("EGP")
  isNegotiable  Boolean          @default(false)
  condition     ProductCondition?

  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  locationId    String
  location      Location         @relation(fields: [locationId], references: [id])
  sellerId      String
  seller        User             @relation(fields: [sellerId], references: [id])

  // Precise map pin — optional. Falls back to the Location's centroid
  // when not set, so map search still works for listings the seller
  // didn't manually place.
  lat           Float?
  lng           Float?

  status        ListingStatus    @default(PENDING_REVIEW)
  viewCount     Int              @default(0)
  clickCount    Int              @default(0) // "call"/"WhatsApp" button taps — a stronger interest signal than raw views

  // Set whenever a paid BoostOrder is active for this listing — reading
  // this one field (rather than joining BoostOrder on every listing
  // query) is what lets the home/category rails cheaply sort boosted
  // listings first.
  boostedUntil  DateTime?

  // SEO — auto-generated from title/category but editable
  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String?
  metaDescriptionEn String?

  images        ProductImage[]
  attributeValues ProductAttributeValue[]
  favorites     Favorite[]
  contactEvents ContactEvent[]
  reports       Report[]
  boosts        BoostOrder[]
  adRequests    AdRequest[]
  cartItems     CartItem[]
  orders        Order[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  expiresAt     DateTime?

  @@index([categoryId, status])
  @@index([locationId, status])
  @@index([sellerId])
  @@index([boostedUntil])
  @@index([status, createdAt])
}

// ──────────────────────────────────────────────────────────────
// BOOSTS — paid promotion for a listing. Only the "tureed" placement
// (higher ranking + badge inside the site) is fully automated: pay,
// and the listing is immediately featured, no human involved.
//
// facebook/instagram/tiktok promotion is a DIFFERENT model, AdRequest
// below — publishing real ads on those platforms needs Meta/TikTok
// Marketing API approval (business verification, app review) that
// doesn't exist yet. Until then, choosing one of those platforms creates
// an AdRequest that lands in the admin queue for a human marketing team
// member to fulfill manually and follow up with the seller directly.
// ──────────────────────────────────────────────────────────────

enum BoostStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

model BoostOrder {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User        @relation(fields: [sellerId], references: [id])

  platforms     String[]    // always ["tureed"] today — see AdRequest for facebook/instagram/tiktok
  days          Int
  pricePerDay   Decimal     @db.Decimal(10, 2) // snapshot of the rate at purchase time, so later price changes don't rewrite history
  totalPrice    Decimal     @db.Decimal(10, 2)

  status        BoostStatus @default(PENDING_PAYMENT)
  paymentRef    String?     // external payment gateway reference, once one is wired up

  viewsAtStart  Int         @default(0) // lets "My Ads" show views gained DURING the boost, not lifetime views
  clicksAtStart Int         @default(0)

  startedAt     DateTime?
  endsAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([sellerId])
  @@index([productId])
}

// A seller's request to advertise a listing on Facebook/Instagram/TikTok.
// This is the whole point of building the logic "correctly, ready for
// Meta API" without pretending the automation exists yet: every field a
// real Marketing API integration would need (platforms, daily budget,
// duration, target audience notes) is captured now, so later the only
// change is swapping the manual fulfillment step for an actual API call
// — the data model and admin queue don't need to change.
enum AdRequestStatus {
  REQUESTED     // seller submitted it, nobody has looked at it yet
  CONTACTED     // marketing team reached out to the seller
  IN_PROGRESS   // campaign is being built (in Meta/TikTok Ads Manager, manually, today)
  LIVE          // campaign is running
  COMPLETED     // campaign finished
  CANCELLED
}

model AdRequest {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User            @relation(fields: [sellerId], references: [id])

  platforms       String[]        // subset of ["facebook","instagram","tiktok"]
  budgetPerDay    Decimal         @db.Decimal(10, 2) // seller's requested daily budget — an ESTIMATE until a human quotes the real one
  days            Int
  estimatedTotal  Decimal         @db.Decimal(10, 2)
  targetNoteAr    String?         @db.Text // free-text from the seller: "target Cairo, ages 25-40" etc. — becomes real audience targeting once the API is wired up
  status          AdRequestStatus @default(REQUESTED)
  adminNote       String?         @db.Text // internal notes from whoever on the marketing team is handling it

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([sellerId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

// The actual filled-in value for one CategoryAttribute on one Product.
// For SELECT: optionId is set. For MULTISELECT: one row per chosen option.
// For NUMBER/BOOLEAN: numberValue/boolValue is set, optionId is null.
model ProductAttributeValue {
  id            String              @id @default(cuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId   String
  attribute     CategoryAttribute   @relation(fields: [attributeId], references: [id])
  optionId      String?
  option        AttributeOption?    @relation(fields: [optionId], references: [id])
  numberValue   Decimal?            @db.Decimal(12, 2)
  boolValue     Boolean?

  @@index([productId])
  @@index([attributeId, optionId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum ReportReason {
  FRAUD
  DUPLICATE
  PROHIBITED
  WRONG_CATEGORY
  OTHER
}

model Report {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  reason     ReportReason
  note       String?
  resolved   Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

// ──────────────────────────────────────────────────────────────
// BUYER SIDE — saved items and direct purchase. Most transactions in a
// classifieds marketplace still happen via call/WhatsApp (see
// ContactButtons), but some sellers/buyers want a direct "Buy Now" —
// this is that path, gated by PlatformSettings.paymentGatewayEnabled.
// ──────────────────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING_PAYMENT // gateway is off, or checkout was started but not completed — treat as a purchase LEAD, not a sale
  PAID
  CANCELLED
  COMPLETED
}

model Order {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId    String
  seller      User        @relation("SellerOrders", fields: [sellerId], references: [id])

  price       Decimal     @db.Decimal(12, 2) // snapshot of Product.price at order time
  status      OrderStatus @default(PENDING_PAYMENT)
  paymentRef  String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────
// PLATFORM SETTINGS — one row, admin-editable. Right now this only
// toggles whether real payment processing is active. Every checkout
// path (Boost, Buy Now) reads this before attempting to charge anyone —
// see src/lib/settings.ts and src/lib/payments.ts. Ships OFF: no money
// moves anywhere until an admin explicitly turns it on with real
// gateway credentials configured.
// ──────────────────────────────────────────────────────────────

model PlatformSettings {
  id                    String   @id @default("singleton")
  paymentGatewayEnabled Boolean  @default(false)
  paymentProvider       String?  // "paymob" | "fawry" | "stripe" — informational until real keys are added
  updatedAt             DateTime @updatedAt
}


// Categories a user said they care about at signup (checkboxes) — the base
// table for targeted ads / lead generation.
model UserInterestCategory {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, categoryId])
  @@index([categoryId])
}

enum ContactEventType {
  CALL
  WHATSAPP
}

// One row every time a logged-in buyer reveals/clicks a seller's contact on
// a listing: who (buyer) -> whom (seller) -> which listing.
model ContactEvent {
  id        String           @id @default(cuid())
  buyerId   String
  buyer     User             @relation("ContactBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User             @relation("ContactSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ContactEventType
  createdAt DateTime         @default(now())

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
}
