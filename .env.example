# Postgres connection string, e.g. from Supabase, Railway, or Neon
DATABASE_URL="postgresql://user:password@localhost:5432/tureed"

# Random long string used to sign session cookies (OTP login).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"

# Optional — real search (Meilisearch). Leave unset to use the built-in
# Postgres fallback search (works, just no relevance ranking/typo tolerance).
# Self-host for free (a $5-6/mo VPS is plenty at launch scale) or use
# Meilisearch Cloud's free tier.
# MEILI_HOST="https://your-meilisearch-instance.example.com"
# MEILI_API_KEY=""

# Optional — real SMS delivery for OTP codes. Without these, codes are
# just logged to the server console (see src/lib/sms.ts) so you can test
# the whole login flow for free during development.
# TWILIO_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""

# Optional — S3-compatible image storage for production (Cloudflare R2
# recommended: no egress fees, cheaper than AWS S3 for an image-heavy
# site). Without these, uploads are written to /public/uploads locally,
# which does NOT persist on most serverless hosts.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_KEY=""
# S3_SECRET=""
# S3_BUCKET=""
# S3_PUBLIC_BASE_URL=""

# --- WhatsApp OTP (primary login channel) — Meta WhatsApp Cloud API, free tier ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=otp_login

# --- Admin database browser (/admin/database) — a SECOND password on top of admin login ---
# ADMIN_DB_PASSWORD=choose-a-long-random-secret

# --- Speed tip (Supabase): use the pooled "Transaction pooler" connection string for DATABASE_URL,
# e.g. postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# and create the project in the region closest to your users (e.g. Frankfurt / Bahrain for Egypt).
# Each page makes several DB queries, so database latency is multiplied on every click.
